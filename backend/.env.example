# ─── Allo backend env — copy to .env and fill in ─────────
# Database (Aiven Postgres, TLS required)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/voicefield
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace-with-a-long-random-string-before-first-user
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# App URLs (production: your real domains)
APP_URL=http://localhost:3002

# Voice (Sarvam STT/TTS — top up credits in Sarvam dashboard)
SARVAM_API_KEY=

# AI reasoning (OpenRouter gateway; free :free models work with no credits)
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b:free
LLM_FALLBACK_MODEL=inclusionai/ling-3.0-flash-vl:free
LLM_MODELS=deepseek/deepseek-chat,qwen/qwen3.8-27b:free,inclusionai/ling-3.0-flash-vl:free
LLM_BASE_URL=https://openrouter.ai/api/v1

# Storage (Cloudflare R2) + optional public URL
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=voicefield
R2_ENDPOINT_URL=
R2_PUBLIC_URL=

# Email (Resend) + sender (use onboarding@resend.dev until domain verified)
RESEND_API_KEY=
EMAIL_FROM=VoiceField <onboarding@resend.dev>

# SMS (Twilio; TWILIO_PHONE_NUMBER optional — falls back to sender ID)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SENDER_ID=VoiceField

# Payments (client provides live keys at launch; test keys for staging)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_M=
STRIPE_PRICE_GROWTH_M=
STRIPE_PRICE_TRADE_M=

# Accounting
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
QB_CLIENT_ID=
QB_CLIENT_SECRET=

# Direct Debit
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=

# Marketing (Brevo key; missing = simulated locally)
BREVO_API_KEY=

# Calendar / reviews
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
GOOGLE_REVIEW_URL=

# WhatsApp Cloud API (Meta dev console, free tier)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Realtime / search / notifications (self-hosted defaults are dev-only)
CENTRIFUGO_URL=http://localhost:8003
CENTRIFUGO_API_KEY=change-me
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=change-me
NOVU_API_KEY=
NOVU_API_URL=http://localhost:3040
N8N_WEBHOOK_URL=http://localhost:5678/webhook
POSTCODES_API_URL=https://api.postcodes.io
VALHALLA_URL=http://localhost:8002
POSTHOG_API_KEY=
POSTHOG_HOST=

# Observability
SENTRY_DSN=
