# AlloVoice Caddyfile. Set DOMAIN env when running (Caddy reads {$DOMAIN}).
# API + websockets (voice, telephony, socket.io) -> backend; everything else -> frontend.
{$DOMAIN} {
	encode gzip

	@api path /api/* /socket.io/* /voice /media /status
	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
